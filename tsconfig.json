{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "index.tsx",
    "App.tsx",
    "constants.ts",
    "types.ts",
    "features/**/*.ts",
    "features/**/*.tsx",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "lib/**/*.ts",
    "vite.config.ts",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src",
    "components",
    "context",
    "services",
    "migrated_prompt_history",
    "*.js",
    "*.cjs"
  ]
}

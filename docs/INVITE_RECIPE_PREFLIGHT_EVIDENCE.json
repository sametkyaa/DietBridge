    {
      "name": "recipes_carbs_range_check",
      "table": "recipes",
      "definition": "CHECK (((carbs >= (0)::numeric) AND (carbs <= (1000)::numeric)))"
    },
    {
      "name": "recipes_description_length_check",
      "table": "recipes",
      "definition": "CHECK (((description IS NULL) OR (char_length(description) <= 2000)))"
    },
    {
      "name": "recipes_dietitian_id_fkey",
      "table": "recipes",
      "definition": "FOREIGN KEY (dietitian_id) REFERENCES profiles(id) ON DELETE CASCADE"
    },
    {
      "name": "recipes_fat_range_check",
      "table": "recipes",
      "definition": "CHECK (((fat >= (0)::numeric) AND (fat <= (1000)::numeric)))"
    },
    {
      "name": "recipes_image_path_canonical_check",
      "table": "recipes",
      "definition": "CHECK (((image_path IS NULL) OR (image_path ~ '^recipes/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.(jpe?g|png|webp)$'::text)))"
    },
    {
      "name": "recipes_image_path_matches_owner_check",
      "table": "recipes",
      "definition": "CHECK (((image_path IS NULL) OR (split_part(image_path, '/'::text, 2) = (dietitian_id)::text)))"
    },
    {
      "name": "recipes_image_path_matches_recipe_check",
      "table": "recipes",
      "definition": "CHECK (((image_path IS NULL) OR (split_part(image_path, '/'::text, 3) = (id)::text)))"
    },
    {
      "name": "recipes_meal_type_check",
      "table": "recipes",
      "definition": "CHECK ((meal_type = ANY (ARRAY['breakfast'::text, 'lunch'::text, 'dinner'::text, 'snack'::text])))"
    },
    {
      "name": "recipes_name_length_check",
      "table": "recipes",
      "definition": "CHECK ((char_length(name) <= 160))"
    },
    {
      "name": "recipes_name_not_blank_check",
      "table": "recipes",
      "definition": "CHECK ((btrim(name) <> ''::text))"
    },
    {
      "name": "recipes_pkey",
      "table": "recipes",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "recipes_protein_range_check",

      "qual": "((bucket_id = 'dietitian-diplomas'::text) AND (name ~ '^diplomas/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/diploma\\.pdf$'::text) AND ( SELECT is_current_user_platform_admin() AS is_current_user_platform_admin))",

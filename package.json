{
  "name": "dietbridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/runAllContractTests.mjs",
    "test:core": "node scripts/runMealPlanContractTests.mjs",
    "test:backend": "node scripts/runBackendQualityGate.mjs",
    "test:e2e": "node scripts/runCriticalE2E.mjs",
    "test:e2e:install": "playwright install chromium",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:notification-core": "node scripts/runNotificationCoreContractTests.mjs",
    "test:notification-core:runtime": "node scripts/runDisposableNotificationCoreRuntimeHarness.mjs",
    "test:push-registry": "node scripts/runPushRegistryContractTests.mjs",
    "test:push-registry:runtime": "node scripts/runDisposablePushRegistryRuntimeHarness.mjs",
    "test:product-admin:runtime": "node scripts/runDisposableProductAdminRuntimeHarness.mjs",
    "test:appointment-reminders:runtime": "node scripts/runDisposableAppointmentReminderRuntimeHarness.mjs",
    "test:notification-client": "node scripts/runNotificationClientContractTests.mjs",
    "test:notification-client:runtime": "node scripts/runDisposableNotificationClientIntegration.mjs",
    "test:notification-ui": "node scripts/runNotificationUiContractTests.mjs",
    "test:appointments": "node scripts/runMealPlanContractTests.mjs --appointments-only",
    "test:appointments:runtime": "node scripts/runDisposableAppointmentRuntimeHarness.mjs",
    "test:daily-tasks": "node scripts/runMealPlanContractTests.mjs --daily-tasks-only",
    "test:daily-tasks:runtime": "node scripts/runDisposableDailyTaskRuntimeHarness.mjs",
    "test:notes": "node scripts/runMealPlanContractTests.mjs --notes-only",
    "test:notes:runtime": "node scripts/runDisposableNoteRuntimeHarness.mjs",
    "test:analytics": "node scripts/runMealPlanContractTests.mjs --analytics-only",
    "test:client-metrics": "node scripts/runClientMetricsContractTests.mjs",
    "test:water": "node scripts/runMealPlanContractTests.mjs --water-only",
    "test:analytics:runtime": "node scripts/runDisposableAnalyticsRuntimeHarness.mjs",
    "test:subscriptions": "node scripts/runMealPlanContractTests.mjs --subscriptions-only",
    "test:subscriptions:runtime": "node scripts/runDisposableSubscriptionRuntimeHarness.mjs",
    "test:mvp10:runtime": "node scripts/runDisposableMvp10SharedContractHarness.mjs",
    "test:meal-visibility:runtime": "node scripts/runDisposableMealVisibilityRuntimeHarness.mjs",
    "test:storage-http": "node scripts/runDisposableMealPhotoStorageHttpHarness.mjs",
    "test:storage-production-shape": "node scripts/runMvp3StoragePolicyProductionShapeSimulation.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.0"
  }
}
